---
import { localizePath, type Lang } from "../i18n";
import { Content as EnContent } from "../dqc/en.md";
import { Content as SkContent } from "../dqc/sk.md";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const Content = lang === "sk" ? SkContent : EnContent;
const otherHref = localizePath("/dqc/ladder", lang === "sk" ? "en" : "sk");
const sk = lang === "sk";
---

<section class="grain relative overflow-hidden border-b border-line">
  <div
    class="absolute inset-0 z-0 opacity-[0.13]"
    style="background:linear-gradient(140deg,#4f46e5,#0891b2)"
    aria-hidden="true"
  >
  </div>
  <div class="relative z-10 mx-auto max-w-5xl px-5 pb-10 pt-12">
    <a
      href={localizePath("/dqc", lang)}
      class="text-sm text-muted transition-colors hover:text-ink"
      >← {sk ? "Späť na DQC" : "Back to DQC"}</a
    >
    <div class="mt-6 flex items-center gap-3">
      <span
        class="flex h-11 w-11 items-center justify-center rounded-2xl text-xl text-white shadow-lg"
        style="background:linear-gradient(140deg,#4f46e5,#0891b2)">⚛</span
      >
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-accent">
          {sk ? "Popularizačný sprievodca" : "A guide for the curious"}
        </p>
        <h1
          class="font-display text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          {sk ? "Kandidátsky rebrík" : "The candidate ladder"}
        </h1>
        <p class="text-sm text-muted">
          {
            sk
              ? "Kam ďalej s DQC — osem možných pokračovaní, vysvetlených od nuly"
              : "Where DQC goes next — eight possible continuations, explained from scratch"
          }
        </p>
      </div>
    </div>
    <p class="mt-5 max-w-3xl text-muted">
      {
        sk
          ? "Malý domáci výskumný program skúša, či by vesmír v najhlbšej vrstve nemohol byť obrovský počítací stroj. Táto stránka vysvetľuje — od úplných základov, bez potreby fyzikálneho vzdelania —, kam sa dá odtiaľto pokračovať, čo by jednotlivé kroky znamenali a akú majú hodnotu."
          : "A small home research programme is testing whether the universe could, at its deepest layer, be a vast computing machine. This page explains — from first principles, no physics background needed — where it can go from here, what each step would mean, and what it is worth."
      }
    </p>
    <p class="mt-3 text-xs text-muted">
      {
        sk
          ? "Stav k 22. augustu 2026 · zostavené z projektového denníka · všetky čísla sú z pre-registrovaných behov"
          : "State as of 22 August 2026 · compiled from the project journal · all figures from pre-registered runs"
      }
    </p>
  </div>
</section>

<section class="mx-auto max-w-5xl px-5 py-10">
  <div class="mb-6 flex items-center justify-between gap-4">
    <div class="flex flex-wrap gap-2">
      <a
        href="https://doi.org/10.5281/zenodo.21464146"
        rel="noopener"
        target="_blank"
        class="rounded-full border border-line px-4 py-1.5 text-xs font-semibold uppercase tracking-wide transition-colors hover:border-accent hover:text-accent"
        >{sk ? "Preprint na Zenode ↗" : "Preprint on Zenodo ↗"}</a
      >
    </div>
    <a
      href={otherHref}
      class="rounded-full border border-line px-4 py-1.5 text-xs font-semibold uppercase tracking-wide transition-colors hover:border-accent hover:text-accent"
      >{sk ? "EN" : "SK"}</a
    >
  </div>
  <article class="prose">
    <Content />
  </article>
</section>
