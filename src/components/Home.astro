---
import { Image } from "astro:assets";
import { projects, content } from "../data/projects";
import { t, type Lang } from "../i18n";
import ProjectCard from "./ProjectCard.astro";
import HeroVideo from "./HeroVideo.astro";
import danielPhoto from "../assets/daniel.webp";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

const liveCount = projects.filter((p) => content(p, lang).status.match(/live/i)).length;
const heroStats =
  lang === "sk"
    ? [
        { value: String(projects.length), label: "projektov" },
        { value: "AI", label: "+ dlhovekosť" },
        { value: "26", label: "rokov skúseností" },
      ]
    : [
        { value: String(projects.length), label: "projects" },
        { value: "AI", label: "+ longevity" },
        { value: "26", label: "years of experience" },
      ];
---

<!-- ============ HERO ============ -->
<section class="relative grain overflow-hidden">
  <div class="aurora" aria-hidden="true">
    <span class="b1"></span><span class="b2"></span><span class="b3"></span>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-5 pb-16 pt-24 sm:pt-32">
    <p class="reveal text-sm font-semibold uppercase tracking-[0.2em] text-muted">
      Daniel Marko
    </p>
    <h1
      class="reveal mt-4 font-display text-5xl font-semibold leading-[1.02] tracking-tight sm:text-7xl"
      style="animation-delay:80ms"
    >
      {lang === "sk" ? "Umelá inteligencia," : "Artificial intelligence,"}
      <br class="hidden sm:block" />
      <span
        class="bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-2)] bg-clip-text text-transparent"
        >{lang === "sk" ? "zdravie a dlhovekosť." : "health & longevity."}</span
      >
    </h1>
    <p
      class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-muted"
      style="animation-delay:160ms"
    >
      {tr("home.intro")}
    </p>

    <div
      class="reveal mt-9 flex flex-wrap items-center gap-3"
      style="animation-delay:240ms"
    >
      <a href="#projects" class="btn btn-dark">{tr("home.projectsTitle")} →</a>
      <a href="#contact" class="btn btn-light">{tr("nav.contact")}</a>
    </div>

    <!-- hero stats -->
    <div
      class="reveal mt-14 flex flex-wrap gap-x-12 gap-y-6 border-t border-line pt-8"
      style="animation-delay:320ms"
    >
      {
        heroStats.map((s) => (
          <div>
            <div class="font-display text-3xl font-semibold">{s.value}</div>
            <div class="text-sm text-muted">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ============ HERO VIDEO (Mira podcast) ============ -->
<section class="mx-auto max-w-5xl px-5 pb-4">
  <div class="mb-5 flex items-center gap-3">
    <span
      class="flex h-9 w-9 items-center justify-center rounded-xl text-white"
      style="background:linear-gradient(140deg,#8b7dfc,#5a49e0)">✦</span
    >
    <div>
      <h2 class="font-display text-xl font-semibold leading-none tracking-tight">
        {lang === "sk" ? "Podcast s Mirou" : "Podcast with Mira"}
      </h2>
      <p class="mt-1 text-sm text-muted">
        {
          lang === "sk"
            ? "Rozhovor o symbiotickej AI"
            : "A conversation about symbiotic AI"
        }
      </p>
    </div>
  </div>
  <HeroVideo
    id="wdhKs--HVfs"
    title={lang === "sk" ? "Podcast s Mirou" : "Podcast with Mira"}
  />
</section>

<!-- ============ PROJECTS ============ -->
<section id="projects" class="mx-auto max-w-5xl scroll-mt-20 px-5 py-20">
  <div class="flex items-end justify-between gap-4">
    <div>
      <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
        {tr("home.projectsTitle")}
      </h2>
      <p class="mt-2 text-muted">{tr("home.projectsLead")}</p>
    </div>
  </div>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((p, i) => <ProjectCard lang={lang} project={p} index={i} />)}
  </div>
</section>

<!-- ============ ABOUT ============ -->
<section id="about" class="scroll-mt-20 border-y border-line bg-card">
  <div class="mx-auto max-w-5xl px-5 py-20">
    <div class="grid gap-10 md:grid-cols-[0.85fr_1.15fr]">
      <!-- identity card -->
      <div>
        <div
          class="h-40 w-40 overflow-hidden rounded-3xl border border-line shadow-lg"
        >
          <Image
            src={danielPhoto}
            alt="Daniel Marko"
            widths={[160, 320]}
            sizes="160px"
            class="h-full w-full object-cover"
          />
        </div>
        <h2 class="mt-6 font-display text-3xl font-semibold tracking-tight">
          Daniel Marko
        </h2>
        <p class="mt-2 font-semibold" style="color:var(--color-accent)">
          {
            lang === "sk"
              ? "Architekt aplikovanej AI · Agentická AI & bezpečnosť AI"
              : "Applied AI Architect · Agentic AI & AI Safety"
          }
        </p>
        <p class="mt-1 text-sm text-muted">
          {
            lang === "sk"
              ? "Bratislava — otvorený Londýnu (hybrid/relokácia)"
              : "Bratislava, Slovakia — open to London (hybrid/relocation)"
          }
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="https://www.linkedin.com/in/daniel-marko-1a185610"
            rel="noopener"
            target="_blank"
            class="btn btn-dark">LinkedIn ↗</a
          >
          <a href="#contact" class="btn btn-light"
            >{tr("nav.contact")}</a
          >
        </div>
        <p class="mt-6 text-sm text-muted">
          {
            lang === "sk"
              ? "Jazyky: slovenčina (native) · čeština · angličtina · nemčina · ruština"
              : "Languages: Slovak (native) · Czech · English · German · Russian"
          }
        </p>
      </div>

      <!-- bio + expertise + career -->
      <div>
        <div class="space-y-5 text-lg leading-relaxed">
          <p>
            {
              lang === "sk"
                ? "Som architekt aplikovanej AI a staviteľ agentických systémov s 25+ rokmi skúseností v podnikovej IT prevádzke, dodávke softvéru, riadení programov a kontinuite biznisu. Túto disciplínu spoľahlivej prevádzky dnes spájam s praktickou tvorbou AI systémov."
                : "I'm an Applied AI architect and agentic-systems builder with 25+ years across enterprise IT operations, software delivery, program management and business continuity. Today I combine that production-reliability discipline with hands-on AI systems work."
            }
          </p>
          <p class="text-muted">
            {
              lang === "sk"
                ? "Som zakladateľ NewAgy a architekt Mira / OpenClaw — perzistentného multi-agentového AI systému s LLM routingom, RAG, hlasovými a messaging pipeline, watchdogmi a bezpečnostne orientovaným návrhom. Staviam reálne AI systémy a prekladám ich do praktického nasadenia, evaluácie, governance a biznis hodnoty."
                : "I'm the founder of NewAgy and the architect of Mira / OpenClaw — a persistent multi-agent AI system with LLM routing, RAG, voice and messaging pipelines, watchdogs and safety-oriented design. I build real AI systems and translate them into practical adoption, evaluation, governance and business value."
            }
          </p>
        </div>

        <!-- expertise tags -->
        <div class="mt-8 flex flex-wrap gap-2">
          {
            [
              "Agentic AI",
              "LLM routing & failover",
              "RAG & vector search",
              "Prompt architecture",
              "AI safety & governance",
              "Enterprise change mgmt",
              "Python · JS · Linux",
            ].map((tag) => (
              <span class="rounded-full border border-line bg-paper px-3 py-1 text-xs font-medium text-muted">
                {tag}
              </span>
            ))
          }
        </div>

        <!-- career -->
        <div class="mt-8 space-y-3 border-t border-line pt-6">
          {
            [
              {
                role:
                  lang === "sk"
                    ? "Change / Program / Business Continuity Manager"
                    : "Change / Program / Business Continuity Manager",
                org: "AT&T Global Network Services",
                yr: "2010 – " + (lang === "sk" ? "súčasnosť" : "present"),
              },
              {
                role: lang === "sk" ? "Zakladateľ & CEO" : "Founder & CEO",
                org: "NewAgy",
                yr: "2024 – " + (lang === "sk" ? "súčasnosť" : "present"),
              },
              {
                role: lang === "sk" ? "Architekt" : "Architect",
                org: "Mira / OpenClaw — agentic AI R&D",
                yr: "2023 – " + (lang === "sk" ? "súčasnosť" : "present"),
              },
              {
                role:
                  lang === "sk"
                    ? "Prednášajúci — Kognitívne systémy / AI"
                    : "Lecturer — Cognitive Systems / AI",
                org: "Comenius University, Bratislava",
                yr: "2006",
              },
            ].map((job) => (
              <div class="flex items-baseline justify-between gap-4">
                <div>
                  <div class="font-semibold">{job.role}</div>
                  <div class="text-sm text-muted">{job.org}</div>
                </div>
                <div class="shrink-0 text-sm text-muted">{job.yr}</div>
              </div>
            ))
          }
          <p class="pt-1 text-sm text-muted">
            {
              lang === "sk"
                ? "Skôr: IBM, Siemens PSE, Slovak Telecom — riadenie programov a releasov."
                : "Earlier: IBM, Siemens PSE, Slovak Telecom — program & release management."
            }
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ CONTACT ============ -->
<section id="contact" class="mx-auto max-w-5xl scroll-mt-20 px-5 py-20">
  <div
    class="panel-dark grain relative overflow-hidden rounded-[2rem] px-8 py-14 sm:px-14"
  >
    <div class="aurora opacity-40" aria-hidden="true">
      <span class="b1"></span><span class="b2"></span>
    </div>
    <div
      class="relative z-10 flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-center"
    >
      <div>
        <h2
          class="font-display text-3xl font-semibold tracking-tight sm:text-4xl"
          style="color:#ffffff"
        >
          {tr("home.contactTitle")}
        </h2>
        <p class="on-dark-muted mt-3 max-w-md">{tr("home.contactLead")}</p>
      </div>
      <a href="mailto:dano.marko@gmail.com" class="btn btn-light shrink-0"
        >dano.marko@gmail.com</a
      >
    </div>
  </div>
</section>
