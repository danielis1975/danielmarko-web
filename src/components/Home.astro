---
import { projects, content } from "../data/projects";
import { t, type Lang } from "../i18n";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<!-- Hero -->
<section class="max-w-5xl mx-auto px-5 pt-20 pb-12">
  <p class="text-sm font-semibold uppercase tracking-widest text-accent">
    Daniel Marko
  </p>
  <h1
    class="mt-3 text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.05]"
  >
    {lang === "sk" ? "AI, zdravie a dlhovekosť." : "AI, health & longevity."}
  </h1>
  <p class="mt-6 max-w-2xl text-lg text-muted leading-relaxed">
    {tr("home.intro")}
  </p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href="#projects"
      class="px-5 py-2.5 rounded-full bg-ink text-white font-semibold text-sm hover:opacity-90 transition-opacity"
      >{tr("home.projectsTitle")}</a
    >
    <a
      href="#contact"
      class="px-5 py-2.5 rounded-full border border-black/15 font-semibold text-sm hover:border-accent hover:text-accent transition-colors"
      >{tr("nav.contact")}</a
    >
  </div>
</section>

<!-- Projects -->
<section id="projects" class="max-w-5xl mx-auto px-5 py-12 scroll-mt-20">
  <h2 class="text-2xl font-bold tracking-tight">{tr("home.projectsTitle")}</h2>
  <p class="mt-1 text-muted">{tr("home.projectsLead")}</p>
  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((p) => {
        const c = content(p, lang);
        return (
          <ProjectCard
            lang={lang}
            slug={p.slug}
            name={c.name}
            tagline={c.tagline}
            status={c.status}
            accent={p.accent}
          />
        );
      })
    }
  </div>
</section>

<!-- About -->
<section id="about" class="max-w-5xl mx-auto px-5 py-12 scroll-mt-20">
  <h2 class="text-2xl font-bold tracking-tight">{tr("home.aboutTitle")}</h2>
  <p class="mt-4 max-w-3xl text-muted leading-relaxed">
    {
      lang === "sk"
        ? "Som Daniel Marko — pracujem na priesečníku umelej inteligencie, zdravia a dlhovekosti. Staviam personalizované AI systémy (Newagy), perzistentných symbiotických agentov (Mira) a skúmam základy poznania (HAI). Verím, že technológia má slúžiť dlhšiemu, zdravšiemu a vedomejšiemu životu."
        : "I'm Daniel Marko — working at the intersection of artificial intelligence, health, and longevity. I build personalized AI systems (Newagy), persistent symbiotic agents (Mira), and research the foundations of cognition (HAI). I believe technology should serve a longer, healthier, and more conscious life."
    }
  </p>
</section>

<!-- Contact -->
<section id="contact" class="max-w-5xl mx-auto px-5 py-12 scroll-mt-20">
  <div
    class="rounded-3xl bg-ink text-white p-8 sm:p-12 flex flex-col sm:flex-row sm:items-center justify-between gap-6"
  >
    <div>
      <h2 class="text-2xl font-bold tracking-tight">{tr("home.contactTitle")}</h2>
      <p class="mt-2 text-white/70 max-w-md">{tr("home.contactLead")}</p>
    </div>
    <a
      href="mailto:dano.marko@gmail.com"
      class="shrink-0 px-6 py-3 rounded-full bg-white text-ink font-semibold text-sm hover:opacity-90 transition-opacity"
      >dano.marko@gmail.com</a
    >
  </div>
</section>
