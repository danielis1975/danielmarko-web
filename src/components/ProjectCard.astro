---
import { Image } from "astro:assets";
import { t, localizePath, type Lang } from "../i18n";
import type { Project } from "../data/projects";
import { content } from "../data/projects";

interface Props {
  lang: Lang;
  project: Project;
  index?: number;
}

const { lang, project, index = 0 } = Astro.props;
const tr = t(lang);
const c = content(project, lang);
const href = localizePath(`/${project.slug}`, lang);
const [g1, g2] = project.gradient;
---

<a
  href={href}
  class="group reveal relative flex flex-col overflow-hidden rounded-3xl border border-line bg-card transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-black/10"
  style={`animation-delay:${index * 80}ms`}
>
  <!-- Image with gradient wash -->
  <div class="relative aspect-[16/10] overflow-hidden">
    <div
      class="absolute inset-0 z-10 opacity-80 mix-blend-multiply transition-opacity duration-300 group-hover:opacity-60"
      style={`background:linear-gradient(140deg, ${g1}, ${g2})`}
    >
    </div>
    <Image
      src={project.image}
      alt={project.imageAlt}
      widths={[300, 600]}
      sizes="(max-width: 640px) 100vw, 33vw"
      class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
    />
    <div
      class="absolute left-4 top-4 z-20 flex h-11 w-11 items-center justify-center rounded-2xl bg-white/90 text-xl shadow-sm backdrop-blur"
    >
      {project.glyph}
    </div>
    <span
      class="absolute right-4 top-4 z-20 rounded-full bg-black/25 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-white backdrop-blur"
      >{c.status}</span
    >
  </div>

  <!-- Body -->
  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-display text-2xl font-semibold tracking-tight">{c.name}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{c.tagline}</p>
    <span
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold"
      style={`color:${project.accent}`}
    >
      {tr("cta.viewProject")}
      <span class="transition-transform duration-300 group-hover:translate-x-1"
        >→</span
      >
    </span>
  </div>
</a>
