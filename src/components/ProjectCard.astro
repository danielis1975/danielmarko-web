---
import { t, localizePath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  slug: string;
  name: string;
  tagline: string;
  status: string;
  accent?: string;
}

const { lang, slug, name, tagline, status, accent = "var(--color-accent)" } =
  Astro.props;
const tr = t(lang);
const href = localizePath(`/${slug}`, lang);
---

<a
  href={href}
  class="group relative flex flex-col rounded-2xl border border-black/8 bg-white p-6 transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-black/5"
>
  <span
    class="absolute top-0 left-6 h-1 w-12 rounded-b-full"
    style={`background:${accent}`}></span>
  <div class="flex items-center justify-between gap-3 mb-2">
    <h3 class="text-xl font-bold tracking-tight">{name}</h3>
    <span
      class="shrink-0 text-[11px] uppercase tracking-wider font-semibold px-2.5 py-1 rounded-full"
      style={`color:${accent};background:color-mix(in srgb, ${accent} 12%, transparent)`}
      >{status}</span
    >
  </div>
  <p class="text-muted text-sm leading-relaxed flex-1">{tagline}</p>
  <span
    class="mt-4 inline-flex items-center gap-1 text-sm font-semibold transition-colors"
    style={`color:${accent}`}
  >
    {tr("cta.viewProject")}
    <span class="transition-transform group-hover:translate-x-1">→</span>
  </span>
</a>
