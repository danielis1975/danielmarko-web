---
import { Image } from "astro:assets";
import { content, type Project } from "../data/projects";
import { t, localizePath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project } = Astro.props;
const tr = t(lang);
const c = content(project, lang);
---

<article class="max-w-5xl mx-auto px-5 pt-12 pb-8">
  <a
    href={`${localizePath("/", lang)}#projects`}
    class="text-sm text-muted hover:text-accent transition-colors"
    >← {tr("project.back")}</a
  >

  <div class="mt-8 grid gap-10 lg:grid-cols-2 items-start">
    <div>
      <span
        class="text-[11px] uppercase tracking-wider font-semibold px-2.5 py-1 rounded-full"
        style={`color:${project.accent};background:color-mix(in srgb, ${project.accent} 12%, transparent)`}
        >{c.status}</span
      >
      <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight">
        {c.name}
      </h1>
      <p class="mt-4 text-xl text-muted leading-relaxed">{c.tagline}</p>

      {
        project.links.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-3">
            {project.links.map((l) => (
              <a
                href={l.url}
                rel="noopener"
                class="px-4 py-2 rounded-full text-sm font-semibold text-white hover:opacity-90 transition-opacity"
                style={`background:${project.accent}`}
              >
                {l.label} ↗
              </a>
            ))}
          </div>
        )
      }
    </div>

    <div
      class="rounded-3xl overflow-hidden border border-black/8 bg-white shadow-sm"
    >
      <Image
        src={project.image}
        alt={project.imageAlt}
        widths={[400, 800]}
        sizes="(max-width: 1024px) 100vw, 50vw"
        class="w-full h-auto object-cover"
      />
    </div>
  </div>

  <div class="mt-12 max-w-3xl">
    <p class="text-lg leading-relaxed">{c.summary}</p>
    {c.note && <p class="mt-4 text-muted italic">{c.note}</p>}

    <h2 class="mt-10 text-xl font-bold tracking-tight">
      {tr("project.highlights")}
    </h2>
    <ul class="mt-4 space-y-3">
      {
        c.highlights.map((h) => (
          <li class="flex gap-3">
            <span
              class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full"
              style={`background:${project.accent}`}
            />
            <span class="leading-relaxed">{h}</span>
          </li>
        ))
      }
    </ul>
  </div>
</article>
