---
import { Image } from "astro:assets";
import { content, projects, type Project } from "../data/projects";
import { t, localizePath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project } = Astro.props;
const tr = t(lang);
const c = content(project, lang);
const [g1, g2] = project.gradient;

const others = projects.filter((p) => p.slug !== project.slug).slice(0, 3);
---

<!-- HERO -->
<section class="grain relative overflow-hidden border-b border-line">
  <div
    class="absolute inset-0 z-0 opacity-[0.13]"
    style={`background:linear-gradient(140deg, ${g1}, ${g2})`}
    aria-hidden="true"
  >
  </div>
  <div class="relative z-10 mx-auto max-w-5xl px-5 pb-12 pt-10">
    <a
      href={`${localizePath("/", lang)}#projects`}
      class="text-sm text-muted transition-colors hover:text-ink"
      >← {tr("project.back")}</a
    >

    <div class="mt-8 grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="reveal">
        <div class="flex items-center gap-3">
          <span
            class="flex h-12 w-12 items-center justify-center rounded-2xl text-2xl text-white shadow-lg"
            style={`background:linear-gradient(140deg, ${g1}, ${g2})`}
            >{project.glyph}</span
          >
          <span
            class="rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-wider"
            style={`color:${project.accent};background:color-mix(in srgb, ${project.accent} 12%, transparent)`}
            >{c.status}</span
          >
        </div>
        <h1
          class="mt-5 font-display text-5xl font-semibold tracking-tight sm:text-6xl"
        >
          {c.name}
        </h1>
        <p class="mt-4 text-xl leading-relaxed text-muted">{c.lead}</p>

        {
          project.links.length > 0 && (
            <div class="mt-7 flex flex-wrap gap-3">
              {project.links.map((l) => (
                <a
                  href={l.url}
                  rel="noopener"
                  target="_blank"
                  class="btn btn-grad"
                  style={`background:linear-gradient(140deg, ${g1}, ${g2})`}
                >
                  {l.label} ↗
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div class="reveal" style="animation-delay:120ms">
        <div
          class="mx-auto max-w-[300px] overflow-hidden rounded-[1.75rem] border border-line bg-card shadow-2xl shadow-black/10"
        >
          <Image
            src={project.image}
            alt={project.imageAlt}
            widths={[300, 600]}
            sizes="(max-width: 1024px) 80vw, 300px"
            class="h-auto w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- STATS -->
{
  c.stats && c.stats.length > 0 && (
    <section class="border-b border-line bg-card">
      <div class="mx-auto grid max-w-5xl grid-cols-2 gap-px px-5 sm:grid-cols-4">
        {c.stats.map((s) => (
          <div class="px-2 py-8 text-center">
            <div
              class="font-display text-3xl font-semibold sm:text-4xl"
              style={`color:${project.accent}`}
            >
              {s.value}
            </div>
            <div class="mt-1 text-sm text-muted">{s.label}</div>
          </div>
        ))}
      </div>
    </section>
  )
}

<!-- BODY + HIGHLIGHTS -->
<section class="mx-auto max-w-5xl px-5 py-16">
  <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr]">
    <div class="space-y-5">
      {c.body.map((p) => <p class="text-lg leading-relaxed">{p}</p>)}
      {c.note && <p class="text-muted italic">{c.note}</p>}
    </div>

    <div>
      <h2 class="font-display text-xl font-semibold tracking-tight">
        {tr("project.highlights")}
      </h2>
      <ul class="mt-5 space-y-4">
        {
          c.highlights.map((h) => (
            <li class="flex gap-3 rounded-2xl border border-line bg-card p-4">
              <span
                class="mt-1.5 h-2 w-2 shrink-0 rounded-full"
                style={`background:${project.accent}`}
              />
              <span class="text-sm leading-relaxed">{h}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<!-- GALLERY -->
{
  project.gallery && project.gallery.length > 0 && (
    <section class="mx-auto max-w-5xl px-5 pb-16">
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
        {project.gallery.map((img) => (
          <div
            class="flex aspect-[4/3] items-center justify-center overflow-hidden rounded-2xl border border-line bg-card p-2 shadow-sm"
          >
            <Image
              src={img}
              alt={`${c.name}`}
              widths={[300, 600]}
              sizes="(max-width: 640px) 50vw, 33vw"
              class="max-h-full w-auto max-w-full rounded-lg object-contain"
            />
          </div>
        ))}
      </div>
    </section>
  )
}

<!-- OTHER PROJECTS -->
<section class="border-t border-line bg-card">
  <div class="mx-auto max-w-5xl px-5 py-14">
    <h2 class="font-display text-2xl font-semibold tracking-tight">
      {lang === "sk" ? "Ďalšie projekty" : "More projects"}
    </h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        others.map((p) => {
          const oc = content(p, lang);
          return (
            <a
              href={localizePath(`/${p.slug}`, lang)}
              class="group flex items-center gap-4 rounded-2xl border border-line bg-paper p-4 transition-all hover:-translate-y-0.5 hover:shadow-lg"
            >
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-xl text-white"
                style={`background:linear-gradient(140deg, ${p.gradient[0]}, ${p.gradient[1]})`}
              >
                {p.glyph}
              </span>
              <div>
                <div class="font-semibold">{oc.name}</div>
                <div class="text-xs text-muted">{oc.status}</div>
              </div>
              <span class="ml-auto text-muted transition-transform group-hover:translate-x-1">
                →
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
